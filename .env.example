# Single-machine defaults. The LoRa gateway forwards accepted summaries to this API.
BACKEND_URL=http://localhost:8000
BACKEND_IP=localhost
LORA_SERIAL_PORT=/dev/serial0
LORA_BAUDRATE=9600
AXON_LORA_OUTBOX_DB=edge/runtime/lora-outbox.sqlite
AXON_LORA_GATEWAY_DB=edge/runtime/lora-gateway.sqlite
INFLUX_URL=http://localhost:8086
INFLUX_ORG=axon
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=change-me-before-demo
INFLUX_USERNAME=admin
INFLUX_PASSWORD=change-me-before-demo
POSTGRES_USER=axon
POSTGRES_PASSWORD=change-me-before-demo
POSTGRES_DB=axon
POSTGRES_PORT=5432
MACHINE_ID=M1
AXON_ASSET_ID=demo-motor-001
PUBLISH_INTERVAL=1
DASHBOARD_REFRESH_SECONDS=3
# MATLAB-file loading plus a cold model may exceed the normal status-refresh timeout.
DATASET_REPLAY_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
# Use external with Docker services; memory is bounded and intended for tests/dev only.
AXON_STORAGE_MODE=external
